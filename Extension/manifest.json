{
  "manifest_version": 3,
  "name": "FocusGuard",
  "description": "Track browser activity and send analytics to FocusGuard Backend.",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusGuard"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}